{
  "extends": "@task-manager/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@task-manager/shared": ["../../packages/shared/src"],
      "@task-manager/shared/*": ["../../packages/shared/src/*"],
      "@task-manager/ui/globals.css": [
        "../../packages/ui/src/styles/globals.css"
      ],
      "@task-manager/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
