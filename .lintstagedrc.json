{
  "apps/api/**/*.{ts,js}": [
    "pnpm exec prettier --write",
    "pnpm exec eslint --config apps/api/eslint.config.mjs --fix"
  ],
  "apps/web/**/*.{ts,tsx,js,jsx,mjs}": [
    "pnpm exec prettier --write",
    "pnpm exec eslint --config apps/web/eslint.config.mjs --fix"
  ],
  "packages/ui/**/*.{ts,tsx,js,jsx}": [
    "pnpm exec prettier --write",
    "pnpm exec eslint --config packages/ui/eslint.config.js --fix"
  ],
  "**/*.{json,css,md,yml,yaml}": ["pnpm exec prettier --write"]
}
